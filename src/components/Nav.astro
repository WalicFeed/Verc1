---
import CtaButton from "./CtaButton.astro";

const links = [
  { label: "Подход", href: "#approach" },
  { label: "Программа", href: "#program" },
  { label: "Ведущий", href: "#host" },
  { label: "Участие", href: "#pricing" },
];
---

<header
  class="sticky top-0 z-40 border-b border-line-soft/70 bg-cream/85 backdrop-blur-md"
>
  <nav class="wrap flex items-center justify-between gap-6 py-3.5">
    <a
      href="#top"
      class="display text-[1.35rem] leading-none tracking-[-0.03em] no-underline"
    >
      Спиральная динамика
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[0.875rem] font-medium text-ink/70 no-underline transition-colors hover:text-ink-strong"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <CtaButton widget="booking" label="Забронировать" class="!px-4 !py-2.5 text-[0.8rem]" />
  </nav>
</header>
