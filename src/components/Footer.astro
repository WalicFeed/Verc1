---
import { footer } from "../data/content";
---

<footer class="border-t border-line-soft">
  <div class="wrap py-12">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <p class="display display-sm">Спиральная динамика</p>
        <p class="mt-2 text-sm text-muted">
          Мармарис · 1 и 2 сентября 2026
        </p>
        <a
          href={`mailto:${footer.email}`}
          class="mt-4 inline-block text-sm text-ink/75 underline decoration-line underline-offset-4 transition-colors hover:text-ink-strong"
        >
          {footer.email}
        </a>
      </div>

      <div class="grid gap-10 sm:grid-cols-2">
        <div>
          <p class="eyebrow">Полезные ссылки</p>
          <ul class="mt-4 space-y-2.5">
            {
              footer.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-ink/75 no-underline transition-colors hover:text-ink-strong"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="eyebrow">Документы</p>
          <ul class="mt-4 space-y-2.5">
            <li>
              <!--
                Кнопка, а не ссылка: элемент открывает диалог, а никуда не ведёт.
                data-legal перехватывается React-островом LegalModal.
                Пока остров не гидрирован, клик просто ничего не делает —
                страница никуда не «прыгает».
              -->
              <button
                type="button"
                data-legal="privacy"
                class="cursor-pointer text-left text-sm text-ink/75 transition-colors hover:text-ink-strong"
              >
                Политика в отношении обработки персональных данных
              </button>
            </li>
            <li>
              <button
                type="button"
                data-legal="offer"
                class="cursor-pointer text-left text-sm text-ink/75 transition-colors hover:text-ink-strong"
              >
                Публичная оферта
              </button>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <hr class="rule my-9" />

    <div
      class="flex flex-col gap-2 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>{footer.copyright}</p>
      <p>{footer.org}</p>
    </div>
  </div>
</footer>
