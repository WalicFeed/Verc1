---
import { hero } from "../data/content";
import CtaButton from "./CtaButton.astro";
---

<section id="top" class="relative overflow-hidden pt-14 pb-16 sm:pt-20 sm:pb-24">
  <!-- Декоративное свечение. Медленно «дышит» — движение есть,
       но текст остаётся неподвижным (приём hs-breathe с arlo.sh). -->
  <div
    aria-hidden="true"
    class="ambient pointer-events-none absolute -top-40 left-1/2 h-[38rem] w-[38rem] rounded-full blur-[110px]"
    style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 68%)"
  >
  </div>

  <!--
    Первый экран уже во вьюпорте, поэтому IntersectionObserver
    отработает по нему сразу при загрузке — каскад проиграется
    как приветственная анимация, без ожидания прокрутки.
  -->
  <div class="wrap stagger relative">
    <p class="eyebrow">{hero.eyebrow}</p>

    <h1 class="display display-xl mt-5">{hero.title}</h1>

    <p class="display display-md mt-4">
      <em>{hero.tagline}</em>
    </p>

    <div class="mt-8 max-w-2xl">
      <p class="lede">{hero.lede}</p>
      <p class="mt-3 text-ink/75">{hero.body}</p>
    </div>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <CtaButton widget="booking" label={hero.ctaPrimary} />
      <a href="#program" class="btn btn-ghost">{hero.ctaSecondary}</a>
    </div>

    <dl
      class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line-soft bg-line-soft sm:grid-cols-3"
    >
      {
        hero.facts.map((fact) => (
          <div class="bg-cream-lt px-5 py-5">
            <dt class="eyebrow">{fact.label}</dt>
            <dd class="mt-1.5 text-[1.05rem] font-medium text-ink-strong">
              {fact.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
